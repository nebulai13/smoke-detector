{
    "name": "smoke-detector/backend",
    "description": "Smoke Detector API (PHP 8.4, Slim)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "infection/infection": "*",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "SmokeDetector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmokeDetector\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.27"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
