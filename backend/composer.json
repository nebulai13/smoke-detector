{
    "name": "smoke-detector/backend",
    "description": "Smoke Detector API (PHP 8.4, Slim)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-sodium": "*",
        "firebase/php-jwt": "^7.2",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "php-di/php-di": "^7.0",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "robmorgan/phinx": "^0.16",
        "slim/slim": "^4.14",
        "symfony/mailer": "^8.1",
        "symfony/uid": "^8.1"
    },
    "require-dev": {
        "infection/infection": "*",
        "league/openapi-psr7-validator": "^0.22",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/yaml": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "SmokeDetector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmokeDetector\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.27"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
