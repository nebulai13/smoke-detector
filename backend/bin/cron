#!/usr/bin/php8.4
<?php

declare(strict_types=1);

// The cron job of the backend. The hosting's cron (IONOS "UnixCron") calls this file every minute:
// its command field takes ONE path, without interpreter, arguments or redirects (HLD §8). Hence
// - the first line names PHP 8.4 itself (plain "php" is 8.3 on that server),
// - the file is executable,
// - every path is derived from where this file lies (cron starts it in another directory),
// - it takes no arguments: it always runs `cron:run` (mail:send, then days:finalize, then
//   housekeeping:purge),
// - it prints nothing: the one line of each run goes to the application log, with a UTC time.
// The exit code is 0 when every step worked. Everything it does lives in SmokeDetector\Console.

use SmokeDetector\Console\CronEntryPoint;
use SmokeDetector\Console\StreamOutput;

require dirname(__DIR__) . '/vendor/autoload.php';

exit((new CronEntryPoint())->run(getenv(), new StreamOutput(STDOUT, STDERR)));
